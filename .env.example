# ===== Основные настройки =====
# Порт, на котором работает платформа (адрес будет http://IP-сервера:8080)
PORT=8080

# Первый администратор — создаётся при самом первом запуске (потом эти строки ни на что не влияют)
ADMIN_EMAIL=admin@company.local
ADMIN_PASSWORD=ПоменяйтеЭтотПароль

# Создать демонстрационный курс и тестового ученика при первом запуске (true / false)
SEED_DEMO=true

# Где хранить базу данных и загруженные файлы (видео, PDF и т.д.)
DATA_DIR=data

# Максимальный размер одного загружаемого файла, МБ (4096 = 4 ГБ)
MAX_UPLOAD_MB=4096

# Сколько дней действует вход без повторного ввода пароля
SESSION_DAYS=30

# Адрес платформы, по которому её открывают сотрудники (для ссылок в письмах и приглашениях)
APP_URL=http://192.168.1.10:8080

# Если платформа открыта через HTTPS (за nginx и т.п.) — поставьте true
COOKIE_SECURE=false

# ===== Почта (необязательно) =====
# Если заполнить — уведомления будут дублироваться на email сотрудников.
# Пример для Яндекс 360: SMTP_HOST=smtp.yandex.ru, SMTP_PORT=465, пароль приложения в SMTP_PASS
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
